<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Samoyed</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Samoyed Deep Link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>samoyed</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>Samoyed Nest OAuth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>top.protium.samoyed</string>
			</array>
		</dict>
	</array>
	<key>SamoyedAppGroupIdentifier</key>
	<string>$(SAMOYED_APP_GROUP_ID)</string>
